# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# Database Configuration
DATABASE_PATH=./data/legallens.sqlite

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Constraints
MAX_FILE_SIZE_BYTES=15728640

# LLM Provider Configuration
# Supported providers: 'mock', 'gemini', 'openai'
LLM_PROVIDER=mock

# Gemini AI (Optional - Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI (Optional - Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
