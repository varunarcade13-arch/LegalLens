# Server Configuration
PORT=3000
NODE_ENV=development

# Primary AI Provider Configuration (Default: gemini; 'mock' for offline/tests only)
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI Service Limits & Timeouts
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=20

# OpenAI (Alternative Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# Database Configuration
DATABASE_PATH=./data/legallens.sqlite

# General API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# File Upload Constraints
MAX_FILE_SIZE_BYTES=15728640
